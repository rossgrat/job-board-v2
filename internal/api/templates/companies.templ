package templates

import "fmt"

templ CompaniesPage(companies []CompanyItem) {
	@Layout("Companies") {
		<div class="companies">
			<h1>Companies</h1>
			<div class="company-list">
				for _, c := range companies {
					@CompanyItemFragment(c)
				}
			</div>
		</div>
	}
}

templ CompanyItemFragment(c CompanyItem) {
	<div class="company-item">
		<div class="company-item__info">
			if c.Favicon != "" {
				<img class="favicon" src={ c.Favicon } alt="" width="14" height="14"/>
			}
			<span class="company-item__name">{ c.Name }</span>
			<span class="company-item__type">{ c.FetchType }</span>
			@companyCounts(c.Counts)
		</div>
		<button
			class={ "btn", templ.KV("btn-success", c.IsActive), templ.KV("btn-danger", !c.IsActive) }
			hx-post={ "/companies/" + c.ID + "/toggle" }
			hx-swap="outerHTML"
			hx-target="closest .company-item"
		>
			if c.IsActive {
				Active
			} else {
				Inactive
			}
		</button>
	</div>
}

templ companyCounts(n CompanyJobCounts) {
	<span class="company-item__counts">
		<span class="count count--total">{ fmt.Sprintf("%d total", n.Total) }</span>
		<span class="count count--technical">{ fmt.Sprintf("%d tech", n.Technical) }</span>
		<span class="count count--accepted">{ fmt.Sprintf("%d accepted", n.Accepted) }</span>
		<span class="count count--filtered">{ fmt.Sprintf("%d filtered", n.FilteredRelevance) }</span>
		<span class="count count--non-technical">{ fmt.Sprintf("%d non-tech", n.NonTechnical) }</span>
		<span class="count count--pending">{ fmt.Sprintf("%d pending", n.Pending) }</span>
		<span class="count count--dead">{ fmt.Sprintf("%d dead", n.Dead) }</span>
	</span>
}
